---
// The offline vector map: OSM parks, river, roads and street labels, plus a pin for every item.
// Used interactively on the main page and statically on the print page.
import basemap from '../data/basemap.json';
import { ITEMS, KINDS } from '../lib/data';
import { KIND_ICON, SEARCH_PIN } from '../lib/icons';
import type { Lang } from '../i18n/strings';
import { STRINGS } from '../i18n/strings';

interface Props { lang: Lang; id?: string; print?: boolean }
const { lang, id = 'map', print = false } = Astro.props;
const t = STRINGS[lang];
const W = basemap.width, H = basemap.height;
// Crop the print map to where the pins are, so it fills the page.
const viewBox = print ? '150 90 700 730' : `0 0 ${W} ${H}`;
// Cafés aren't printed: there are too many for paper. Draw order follows KINDS (cafés underneath).
const pins = KINDS.flatMap((k) => ITEMS.filter((i) => i.kind === k && !(print && k === 'cafe')));
---
<svg id={id} class:list={['map', { 'map--print': print }]} viewBox={viewBox} data-full={`0 0 ${W} ${H}`}
  role="group" aria-label={t.mapLabel} style="direction: ltr">
  <rect x={-W} y={-H} width={W * 3} height={H * 3} class="land" />
  <path d={basemap.parks} class="parks" />
  <g class="roads">
    <path d={basemap.tertiary} class="road road--tertiary" />
    <path d={basemap.secondary} class="road road--secondary" />
    <path d={basemap.primary} class="road road--primary" />
    <path d={basemap.trunk} class="road road--trunk" />
    <path d={basemap.motorway} class="road road--motorway" />
  </g>
  <path d={basemap.river} class="river" />
  <g class="labels" aria-hidden="true">
    {basemap.labels.map((l) => (
      <text data-r={l.r} class:list={{ river: 'river' in l }} transform={`translate(${l.x} ${l.y}) rotate(${l.a})`} dy="0.35em">{l.t}</text>
    ))}
  </g>
  <g class="pins">
    {pins.map((i) => (
      <g class={`pin pin--${i.kind}`} data-id={i.id} style={`--x:${i.x.toFixed(1)}px;--y:${i.y.toFixed(1)}px`}
        tabindex={print ? undefined : '0'} role={print ? undefined : 'button'}
        aria-label={i.n ? `${i.n}. ${i.name[lang]}` : `${i.name[lang]}, ${t.type[i.kind]}`}>
        {i.kind === 'neighbourhood'
          ? <><circle r="10" /><text class="num" dy="3.6">{i.n}</text></>
          : <>
              {i.kind === 'serviceontario' ? <rect x="-9" y="-9" width="18" height="18" rx="5" class="bg" /> : <circle r={i.kind === 'cafe' ? 7.5 : 9} class="bg" />}
              <g class="icon" transform={i.kind === 'cafe' ? 'translate(-5 -5) scale(.4167)' : 'translate(-6 -6) scale(.5)'} set:html={KIND_ICON[i.kind]} />
              {print && i.code && <text class="code" x="11" dy="3.5">{i.code}</text>}
            </>}
      </g>
    ))}
    {!print && (
      <g class="pin pin--search hidden" data-id="__addr" aria-hidden="true">
        <g transform="translate(-12 -22)" set:html={SEARCH_PIN} />
      </g>
    )}
  </g>
</svg>
