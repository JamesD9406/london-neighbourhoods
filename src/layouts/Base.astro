---
import '../styles/global.css';
import { LANG_META, STRINGS, type Lang } from '../i18n/strings';

interface Props { lang: Lang; title: string; print?: boolean }
const { lang, title, print = false } = Astro.props;
const t = STRINGS[lang];
---
<!doctype html>
<html lang={lang} dir={LANG_META[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={t.subtitle} />
    <meta name="theme-color" content="#125f67" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    {['en', 'es', 'ar'].map((l) => <link rel="alternate" hreflang={l} href={`/${l}/`} />)}
  </head>
  <body class:list={{ 'is-print': print }}>
    <slot />
    {!print && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        }
      </script>
    )}
  </body>
</html>
